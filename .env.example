# Copy to .env.local (ignored by git) and fill in from https://dashboard.emailjs.com
# On Netlify, add the same variables under Site configuration > Environment variables.
# Setup steps and the two email templates are in emailjs/README.md.

# Inbox that receives contact-form messages
VITE_CONTACT_EMAIL=axldamnaxl@gmail.com

# EmailJS > Email Services > Service ID
VITE_EMAILJS_SERVICE_ID=
# EmailJS > Account > General > Public Key
VITE_EMAILJS_PUBLIC_KEY=
# EmailJS > Email Templates > "Portfolio: new message" > Template ID
VITE_EMAILJS_TEMPLATE_OWNER=
# EmailJS > Email Templates > "Portfolio: auto-reply" > Template ID
VITE_EMAILJS_TEMPLATE_REPLY=
